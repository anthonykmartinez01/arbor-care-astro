# Cloudflare Pages headers — mirrors the [[headers]] blocks in netlify.toml.
# Verified against the live Netlify responses: hashed/static assets get the
# immutable cache header AND the sitewide security headers (both apply).

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
